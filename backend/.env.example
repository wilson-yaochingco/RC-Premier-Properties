# ---------------------------------------------------------------------------
# RC Premier Properties — backend environment template
# Copy to .env and adjust. Never commit .env or real credentials.
# ---------------------------------------------------------------------------

# --- Server and deployment --------------------------------------------------
PORT=5000
# development | test | production. Staging uses production so all security gates apply.
NODE_ENV=development
# Exact trusted reverse-proxy hop count. Production requires an explicit value; use 0
# only for a verified direct connection and otherwise count the real trusted proxy layers.
TRUST_PROXY_HOPS=0
# Bounded time allowed for in-flight work before shutdown forces connections closed.
SHUTDOWN_GRACE_SECONDS=30
# Optional non-secret commit/deployment identifier (letters, numbers, dot, _ and - only).
APP_BUILD_ID=
# debug | info | warn | error. Production defaults to info; never use debug to capture
# request bodies, headers, tokens, cookies, customer messages, or private locations.
LOG_LEVEL=debug

# --- Public origins ---------------------------------------------------------
# Exact browser origin allowed to call the API. Never use "*".
CORS_ORIGIN=http://localhost:3000
# Exact public API origin used by Auth0 callbacks. Required and HTTPS in production.
API_PUBLIC_ORIGIN=http://localhost:5000
# Optional exact HTTPS object-storage/CDN origin for production property images. Leave
# blank until a provider is selected; when set it must match NEXT_PUBLIC_MEDIA_ORIGIN.
MEDIA_PUBLIC_ORIGIN=

# --- Database ---------------------------------------------------------------
# Required. Production/staging requires an encrypted, certificate-valid, non-local URI
# with an explicit database. Explicit TLS disablement, conflicting weak aliases, and
# tlsInsecure/tlsAllowInvalid* options fail startup. Prefer an Atlas mongodb+srv URI from
# the deployment secret store; credentials and the URI must never be logged.
MONGODB_URI=mongodb://127.0.0.1:27017/rc_premier

# --- Staff authentication (Auth0) ------------------------------------------
# Leave the six required values below empty only in development/test. Production fails
# startup unless every value is supplied through the deployment secret/config store.
# Issuer format: https://<tenant-region-domain>/
AUTH0_ISSUER_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Exact public API callback, on API_PUBLIC_ORIGIN:
#   http://localhost:5000/api/v1/auth/callback
AUTH0_CALLBACK_URL=
# Comma-separated exact frontend destinations, all on CORS_ORIGIN:
#   http://localhost:3000/,http://localhost:3000/admin
AUTH_ALLOWED_RETURN_URLS=
# Generate at least 32 random bytes. This application secret must differ by environment.
AUTH_SESSION_HASH_SECRET=

# Every environment requires a completed Auth0 MFA challenge reported as `amr: mfa`.
# Configure database/password login + mandatory TOTP in Auth0; disable passkeys,
# WebAuthn and public signup. RC Premier never stores a password or MFA seed.
AUTH_REQUIRED_AMR=mfa
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_ABSOLUTE_HOURS=8
AUTH_MAX_CONCURRENT_SESSIONS=3
AUTH_TRANSACTION_MINUTES=10

# --- Business notifications -------------------------------------------------
# Recipient for existing contact, seller and viewing inquiries. This is not a sender,
# an infrastructure account, or an authorization allowlist.
BUSINESS_NOTIFICATION_EMAIL=rcpremierph@gmail.com

# Production object storage and transactional email providers are not selected. Their
# credentials are intentionally absent from this template until a real adapter/provider
# decision exists; never place provider keys in NEXT_PUBLIC_* variables.
