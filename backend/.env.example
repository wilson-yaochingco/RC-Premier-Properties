# ---------------------------------------------------------------------------
# RC Premier Properties — backend environment template
# Copy to .env and adjust. Never commit .env or real credentials.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
# Port the Express server listens on.
PORT=5000
# development | test | production
NODE_ENV=development
# Exact trusted reverse-proxy hop count. Keep 0 for direct/local connections.
# Set this only after the production proxy topology is known.
TRUST_PROXY_HOPS=0

# --- Database ---------------------------------------------------------------
# Local MongoDB, or a MongoDB Atlas SRV string:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rc_premier
# Required — the server will not start without it.
MONGODB_URI=mongodb://127.0.0.1:27017/rc_premier

# --- CORS -------------------------------------------------------------------
# Origin allowed to call this API (the frontend). Never use "*".
CORS_ORIGIN=http://localhost:3000

# --- Staff authentication (Auth0 Free) --------------------------------------
# Leave the six required values below empty until you create the development
# Auth0 tenant. If any one is supplied, the backend requires and validates all six.
# Issuer format: https://<tenant-region-domain>/
AUTH0_ISSUER_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Exact backend callback format:
#   http://localhost:5000/api/v1/auth/callback
AUTH0_CALLBACK_URL=
# Comma-separated exact frontend destinations, all on CORS_ORIGIN:
#   http://localhost:3000/,http://localhost:3000/admin
AUTH_ALLOWED_RETURN_URLS=
# Generate at least 32 random bytes locally. This is an application secret, not
# the Auth0 client secret, and must differ between environments.
AUTH_SESSION_HASH_SECRET=

# Production requires a completed Auth0 MFA challenge reported as `amr: mfa`.
# Development may alternatively accept the signed passkey claim emitted by the
# exact Post-Login Action documented in docs/development/auth0-setup.md.
# Production refuses values above these baselines and requires AUTH_REQUIRED_AMR=mfa.
AUTH_REQUIRED_AMR=mfa
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_ABSOLUTE_HOURS=8
AUTH_MAX_CONCURRENT_SESSIONS=3
AUTH_TRANSACTION_MINUTES=10
