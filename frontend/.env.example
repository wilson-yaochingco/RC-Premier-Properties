# ---------------------------------------------------------------------------
# RC Premier Properties — frontend environment template
# Copy to .env.local and adjust. Never commit .env.local.
# ---------------------------------------------------------------------------

# Base URL of the backend API. Must be prefixed with NEXT_PUBLIC_ to be readable
# in the browser. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public origin used for canonical URLs, sitemap and social metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leaflet evaluation tiles. This local/test default needs no secret client key.
# The production provider remains a Phase 2B decision; retaining Stadia would require
# an appropriate plan and registered frontend domain.
NEXT_PUBLIC_MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png
