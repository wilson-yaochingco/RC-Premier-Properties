# ---------------------------------------------------------------------------
# RC Premier Properties — frontend environment template
# Copy to .env.local and adjust. Never commit .env.local.
# ---------------------------------------------------------------------------

# development | test | staging | production
# Staging and production enable strict non-local HTTPS validation. Although this value
# is browser-visible, it contains no secret.
# Vercel Preview requires staging. A dedicated beta project also uses staging on its
# Production deployment target. Hosted Vercel rejects omitted/development/test modes.
# See docs/development/vercel-beta.md for fixed same-site origins and provider gates.
NEXT_PUBLIC_DEPLOYMENT_ENV=development

# Exact public origins, without a trailing slash or path. Staging and production require
# both values and reject HTTP, loopback hosts, credentials, paths, queries, and fragments.
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional exact HTTPS origin approved to deliver production property images. Leave
# blank until storage/CDN is selected. It must match backend MEDIA_PUBLIC_ORIGIN.
NEXT_PUBLIC_MEDIA_ORIGIN=

# Leaflet evaluation configuration. Staging and production must replace all three values
# with the approved provider URL, plain-text attribution, and attribution link. A tile URL
# must retain the {z}, {x}, and {y} placeholders. Do not place secret keys here.
NEXT_PUBLIC_MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png
NEXT_PUBLIC_MAP_ATTRIBUTION_TEXT=Stadia Maps, OpenMapTiles and OpenStreetMap
NEXT_PUBLIC_MAP_ATTRIBUTION_URL=https://stadiamaps.com/attribution/
