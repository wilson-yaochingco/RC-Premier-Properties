# RC Premier Properties - Vercel production environment TEMPLATE (sanitized).
#
# Every value below is a placeholder. Copy to a Git-ignored file such as
# frontend/.env.vercel-production.local, replace each <placeholder>, then paste or import
# it into Vercel for the Production environment only. These are the ONLY variables the
# Vercel frontend reads; all are public (NEXT_PUBLIC_*) and baked in at build time.
# Never add a secret here. See docs/development/launch-readiness.md.

NEXT_PUBLIC_DEPLOYMENT_ENV=production
NEXT_PUBLIC_SITE_URL=https://<final-frontend-origin>
NEXT_PUBLIC_API_URL=https://<final-api-origin>
NEXT_PUBLIC_MEDIA_ORIGIN=https://res.cloudinary.com
NEXT_PUBLIC_MAP_TILE_URL=https://<approved-tile-host>/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION_TEXT=<plain-text attribution>
NEXT_PUBLIC_MAP_ATTRIBUTION_URL=https://<attribution-link>
