# Single-app Vercel production TEMPLATE: placeholders only, no real credentials.
# Public variables are embedded at build time. Server values remain server-only.
# Populate a Git-ignored file or Vercel dashboard; mark server secrets Sensitive.
# Preview: use every key with staging values and DEPLOYMENT_ENV=staging.
# Do not set NODE_ENV, PORT or SHUTDOWN_GRACE_SECONDS on Vercel.

NEXT_PUBLIC_DEPLOYMENT_ENV=production
NEXT_PUBLIC_SITE_URL=https://<site-origin>
NEXT_PUBLIC_API_URL=https://<site-origin>
NEXT_PUBLIC_MEDIA_ORIGIN=https://res.cloudinary.com
NEXT_PUBLIC_MAP_TILE_URL=https://<approved-tile-host>/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION_TEXT=<approved-plain-text-attribution>
NEXT_PUBLIC_MAP_ATTRIBUTION_URL=https://<approved-attribution-link>

# Server config: same origin as both public URLs.
CORS_ORIGIN=https://<site-origin>
API_PUBLIC_ORIGIN=https://<site-origin>
# BLOCKER: Wilson measures this in Phase 5; explicitly set before any deployment.
TRUST_PROXY_HOPS=<measured-proxy-hop-count>
AUTH0_ISSUER_URL=https://<auth0-tenant>/
AUTH0_CLIENT_ID=<production-auth0-client-id>
AUTH0_CALLBACK_URL=https://<site-origin>/api/v1/auth/callback
AUTH_ALLOWED_RETURN_URLS=https://<site-origin>/,https://<site-origin>/admin
BUSINESS_NOTIFICATION_EMAIL=<confirmed-inquiry-mailbox>
LOG_LEVEL=info
# Optional; defaults to Cloudinary with its credentials configured.
MEDIA_PUBLIC_ORIGIN=https://res.cloudinary.com

# Server secrets: mark every value Sensitive; never use NEXT_PUBLIC_ prefixes.
MONGODB_URI=mongodb+srv://<least-privilege-user>:<password>@<atlas-host>/rc_premier_prod?tls=true
AUTH0_CLIENT_SECRET=<production-auth0-client-secret>
AUTH_SESSION_HASH_SECRET=<at-least-32-random-bytes>
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# Wilson configures Vercel Firewall login-start and inquiry rules in Phase 5.
# See nextjs-fullstack-migration-plan.md section 7 and launch-readiness.md.
